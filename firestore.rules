rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function isMember(fid) {
      return signedIn() && exists(famPath(fid)) && request.auth.uid in get(famPath(fid)).data.members;
    }
    // Someone with a valid, unexpired invite code may add only themselves to a family.
    function joining(fid) {
      let inv = get(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastInvite'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members)
        && inv.familyId == fid
        && inv.expires > request.time;
    }

    // Captain's log: each person's log is private to them.
    match /caplogs/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /caplogs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Each person's pointer to their family. Only they can read or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes. You need the exact code to read one; they can't be listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.familyId);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // A family, and everything inside it (children, entries, photos),
    // is visible only to its members.
    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid
          && request.auth.uid in request.resource.data.members)
        || joining(fid));

      match /{document=**} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
